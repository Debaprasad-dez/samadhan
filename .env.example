# OpenRouter (server-side only -- never expose to the client)
# Preferred: route AI through a serverless proxy that injects the key.
# Set this to YOUR OWN proxy endpoint (do not commit a real one to a public repo).
OPENROUTER_CHAT_URL=https://your-proxy.example.com/api/chat
OPENROUTER_MODEL=openai/gpt-oss-120b
# Direct mode (used only if OPENROUTER_CHAT_URL is unset):
OPENROUTER_API_KEY=sk-or-v1-replace-me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Session (generate a random 32+ char string)
SESSION_PASSWORD=replace-with-32-plus-character-random-string-xxxxxxxxxx

# Database
DATABASE_URL=file:./dev.db

# App
NEXT_PUBLIC_APP_NAME=Samadhan
NEXT_PUBLIC_DEMO_MODE=true
